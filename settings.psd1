# =====================================================================
# Windots 用户全局配置 (settings.psd1)
# 修改此文件后重新运行 setup.ps1 或 windots install 使配置生效
# =====================================================================
@{
    # ------------------------------------------------------------------
    # 代理
    # 在国内访问 GitHub/winget 源较慢时可启用
    # 安装 PowerShell 7 之前也会交互询问一次
    # ------------------------------------------------------------------
    Proxy   = @{
        Enabled = $false
        Url     = 'http://127.0.0.1:10808'       # 例如 'http://127.0.0.1:10808'
    }

    # ------------------------------------------------------------------
    # Scoop
    # ------------------------------------------------------------------
    Scoop   = @{
        # 是否切换到国内 gitee 镜像（交互时仍会再确认一次）
        UseMirror = $true
    }

    # ------------------------------------------------------------------
    # chezmoi（跨平台工具配置同步）
    # ------------------------------------------------------------------
    Chezmoi = @{
        Username    = ''          # GitHub 用户名，留空则运行时询问
        RepoName    = 'dotfiles'  # 默认仓库名（chezmoi 官方约定）
        ApplyOnInit = $true       # init 时是否直接 --apply
    }

    # ------------------------------------------------------------------
    # 路径（相对仓库根）
    # ------------------------------------------------------------------
    Paths   = @{
        Dotfiles = './dotfiles'                # 本地配置源目录
        Backup   = './backup'                  # 备份目录
        Logs     = './logs'                    # 日志目录
        State    = './.windots-state.psd1'     # 交互结果持久化
    }
}